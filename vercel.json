{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/lead-reminders",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home-safety-inspection",
      "destination": "/home-safety-assessment",
      "permanent": true
    },
    {
      "source": "/free-home-safety-assessment",
      "destination": "/home-safety-assessment",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/estimate/:token",
      "destination": "/index.html"
    },
    {
      "source": "/proposal/:token",
      "destination": "/index.html"
    },
    {
      "source": "/agreement/:token",
      "destination": "/index.html"
    },
    {
      "source": "/admin/config-preview",
      "destination": "/index.html"
    },
    {
      "source": "/partner",
      "destination": "/index.html"
    },
    {
      "source": "/partner/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/internal",
      "destination": "/index.html"
    },
    {
      "source": "/internal/(.*)",
      "destination": "/index.html"
    }
  ]
}
