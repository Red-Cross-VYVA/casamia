{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/lead-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/visit-reminders",
      "schedule": "15 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/contact",
      "destination": "/why-us#contact-form",
      "permanent": true
    },
    {
      "source": "/home-safety-inspection",
      "destination": "/home-safety-assessment",
      "permanent": true
    },
    {
      "source": "/free-home-safety-assessment",
      "destination": "/home-safety-assessment",
      "permanent": true
    },
    {
      "source": "/bathroom-safety-for-seniors",
      "destination": "/services/bathroom-safety",
      "permanent": true
    },
    {
      "source": "/senior-bedroom-safety",
      "destination": "/services/bedroom-safety",
      "permanent": true
    },
    {
      "source": "/connected-home-for-seniors",
      "destination": "/services/smart-home-safety",
      "permanent": true
    },
    {
      "source": "/grants-for-home-adaptations-spain",
      "destination": "/grants",
      "permanent": true
    },
    {
      "source": "/family-dashboard",
      "destination": "/tech",
      "permanent": true
    },
    {
      "source": "/tools/home-vs-residence-cost-calculator",
      "destination": "/blog/when-home-adaptations-are-not-enough",
      "permanent": true
    },
    {
      "source": "/tools/senior-friendly-home-check",
      "destination": "/tools/is-my-parent-safe-at-home",
      "permanent": true
    },
    {
      "source": "/es/tools/senior-friendly-home-check",
      "destination": "/es/tools/is-my-parent-safe-at-home",
      "permanent": true
    },
    {
      "source": "/es/partner",
      "destination": "/partner",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/es/estimate/:token",
      "destination": "/index.html"
    },
    {
      "source": "/estimate/:token",
      "destination": "/index.html"
    },
    {
      "source": "/proposal/:token",
      "destination": "/index.html"
    },
    {
      "source": "/agreement/:token",
      "destination": "/index.html"
    },
    {
      "source": "/admin/config-preview",
      "destination": "/index.html"
    },
    {
      "source": "/partner",
      "destination": "/index.html"
    },
    {
      "source": "/partner/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/internal",
      "destination": "/index.html"
    },
    {
      "source": "/internal/(.*)",
      "destination": "/index.html"
    }
  ]
}
